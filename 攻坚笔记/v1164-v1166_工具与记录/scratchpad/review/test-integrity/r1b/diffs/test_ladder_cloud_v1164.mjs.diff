+  emu = H.makeEmulator({ knobs: { permissionMode: 'legacy', latencyMs: 40, jitterMs: 40, consistencyLagMs: 300 } });
+  names = {};
+  const E = await phone('戊', null, '/island_animal.html');
+  await H.dismissIslandWelcome(E);
