+    const r = await B.fetchTop();
+    ok(r.ok === false && r.kind === 'network', '★ 断网 → kind=network（界面才能说「连不上网络」）');
+  }
+  {
+    const { B } = bootBoard({ signed: false });
+    const r = await B.fetchTop();
+    ok(r.ok === false && r.reason === 'not-signed-in', '真没登录才说 not-signed-in（天梯页据此显示「登录之后就能看到」）');
+  }
+  {
