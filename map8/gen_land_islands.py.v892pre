BOSS_META={
 # ① 迷雾心湖 · 混沌异形系
 '虫群先锋·刃翼领主':B('虫群先锋·刃翼领主','land_renyi.png','#7fae3a','虫巢在低语…','刃翼, 撕裂它!','你也将成为巢的一部分!'),
 '未成形之神·万形之胚':B('未成形之神·万形之胚','land_wanxing.png','#c9a6e8','我是万形, 亦是无形…','猜猜我下一秒是什么?','你的形态…我要了!'),
 '逆相之影·镜渊领主':B('逆相之影·镜渊领主','land_jingyuan.png','#8fb8d8','镜中的你在笑呢…','来, 看看真正的自己!','碎镜千片, 皆是你!'),
 '混沌之种·万象侵蚀者':B('混沌之种·万象侵蚀者','land_hundun.png','#9a6ac8','腐化…已经开始了。','万象终将归于混沌!','连光都会被我吞噬!'),
 '魔皇·小丑至尊':B('魔皇·小丑至尊','land_mohuang.png','#c04a9a','欢迎来到我的马戏团!','哈哈哈! 抽一张牌吧!','游戏结束…我赢了♠!'),
 # ② 风纹草原 · 军事战术系
